{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucas-mateus-hq.github.io/lucas-capability-os-pages/protocol/capability-evidence-receipt.schema.json",
  "title": "Capability Evidence Receipt",
  "type": "object",
  "required": [
    "protocol_version",
    "receipt_id",
    "capability_id",
    "task",
    "executor",
    "acceptance_criteria",
    "evidence",
    "evaluation",
    "promotion",
    "created_at"
  ],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "executor": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {"type": "string", "enum": ["model", "agent", "human", "hybrid"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "ref"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "summary": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["evaluator", "outcome"],
      "properties": {
        "evaluator": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "enum": ["pass", "fail", "inconclusive"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "promotion": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "enum": ["eligible", "blocked", "review_required"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
