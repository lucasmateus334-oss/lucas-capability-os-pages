---
import OperatorProfile from '../components/OperatorProfile.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index,follow" />
  <meta name="description" content="The story behind Capability Lab: Lucas Mateus' path from people, learning and international work into AI-assisted experimentation and evidence-driven systems." />
  <title>About Lucas Mateus — The story behind Capability Lab</title>
</head>
<body>
  <header class="about-bar">
    <a href="./">← Capability OS</a>
    <nav class="story-nav" aria-label="Story chapters">
      <a href="#origin" data-section="origin"><span class="en">Origin</span><span class="pt">Origem</span></a>
      <a href="#career" data-section="career"><span class="en">Career</span><span class="pt">Trajetória</span></a>
      <a href="#turn" data-section="turn"><span class="en">AI turn</span><span class="pt">Virada IA</span></a>
      <a href="#lab" data-section="lab">C. Lab</a>
      <a href="#now" data-section="now"><span class="en">Evidence</span><span class="pt">Evidência</span></a>
      <a href="#proof" data-section="proof"><span class="en">Signals</span><span class="pt">Sinais</span></a>
      <a href="#maturity" data-section="maturity"><span class="en">Maturity</span><span class="pt">Maturidade</span></a>
    </nav>
    <div class="language-switcher" role="group" aria-label="Language">
      <button type="button" data-lang="en" aria-label="English" aria-pressed="true">🇺🇸 <span>EN</span></button>
      <button type="button" data-lang="pt-BR" aria-label="Português do Brasil" aria-pressed="false">🇧🇷 <span>PT-BR</span></button>
    </div>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
  </header>
  <main><OperatorProfile /></main>
  <script is:inline>
    const applyLanguage = (lang) => {
      const selected = lang === 'pt-BR' ? 'pt-BR' : 'en';
      document.documentElement.lang = selected;
      document.querySelectorAll('[data-lang]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.lang === selected)));
      try { localStorage.setItem('capability-os-language', selected); } catch {}
    };
    const preferred = (() => { try { return localStorage.getItem('capability-os-language'); } catch { return null; } })();
    applyLanguage(preferred || (navigator.language?.toLowerCase().startsWith('pt') ? 'pt-BR' : 'en'));
    document.querySelectorAll('[data-lang]').forEach((button) => button.addEventListener('click', () => applyLanguage(button.dataset.lang)));

    const navLinks = [...document.querySelectorAll('.story-nav a')];
    const observed = navLinks.map((link) => document.getElementById(link.dataset.section)).filter(Boolean);
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a,b) => b.intersectionRatio-a.intersectionRatio)[0];
      if (!visible) return;
      navLinks.forEach((link) => link.toggleAttribute('aria-current', link.dataset.section === visible.target.id));
    }, { rootMargin: '-25% 0px -60% 0px', threshold: [0,.2,.5] });
    observed.forEach((section) => observer.observe(section));

    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      document.querySelector('.reading-progress span')?.style.setProperty('transform', `scaleX(${ratio})`);
    };
    updateProgress();
    addEventListener('scroll', updateProgress, { passive:true });
  </script>
</body>
</html>
<style is:global>
:root{--ink:#11110f;--paper:#f4f4f0;--line:#c8c8c1}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased}.about-bar{position:sticky;top:0;z-index:30;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px;min-height:64px;padding:0 28px;border-bottom:1px solid #111;background:rgba(244,244,240,.95);backdrop-filter:blur(10px)}.about-bar>a{font:700 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;text-decoration:none;white-space:nowrap}.story-nav{justify-self:center;display:flex;gap:14px}.story-nav a{position:relative;padding:8px 0;text-decoration:none;font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:#777;white-space:nowrap}.story-nav a[aria-current]{color:#111}.story-nav a[aria-current]::after{content:"";position:absolute;left:0;right:0;bottom:2px;height:1px;background:#111}.language-switcher{display:flex;border:1px solid #c9c9c2;border-radius:999px;padding:2px;background:#fff}.language-switcher button{border:0;background:transparent;border-radius:999px;padding:6px 9px;font:700 9px ui-monospace,SFMono-Regular,Menlo,monospace;cursor:pointer;color:#666}.language-switcher button[aria-pressed="true"]{background:#111;color:#fff}.reading-progress{position:absolute;left:0;right:0;bottom:-1px;height:2px;overflow:hidden}.reading-progress span{display:block;width:100%;height:100%;background:#111;transform:scaleX(0);transform-origin:left center;will-change:transform}main{width:min(100%,1600px);margin:0 auto;padding:0 28px 42px}.pt{display:none}html[lang="pt-BR"] .en{display:none}html[lang="pt-BR"] .pt{display:inline}@media(max-width:1080px){.story-nav{gap:10px}.story-nav a{font-size:8px}}@media(max-width:920px){.about-bar{grid-template-columns:1fr auto}.story-nav{display:none}}@media(max-width:640px){.about-bar{padding:0 18px;gap:12px}.language-switcher button span{display:none}.language-switcher button{padding:6px 8px}main{padding:0 18px 32px}}
</style>
