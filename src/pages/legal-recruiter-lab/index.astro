---
import { recruiterLabCommerce, checkoutCopy } from '../../data/recruiterLabCommerce';

const modules = [
  ['01','Market Map','Understand the U.S. legal market, firm types and career paths.'],
  ['02','Read the Work','Decode practice areas, jurisdictions and the economics behind legal work.'],
  ['03','Read Talent','Assess résumé signals, ownership, trajectory and motivation with evidence.'],
  ['04','Run the Search','Build stronger intake, mapping, sourcing and outreach decisions.'],
  ['05','Close the Search','Navigate offers, counteroffers and higher-stakes search dynamics.'],
  ['06','Operate Well','Apply ethics, inclusion, AI judgment and a structured first-90-days plan.'],
];
const checkoutEnabled = recruiterLabCommerce.mode !== 'disabled' && Boolean(recruiterLabCommerce.checkoutUrl);
const policyLinks = [
  ['Privacy','./privacy'],
  ['Terms','./terms'],
  ['Refunds','./refund'],
  ['Support','./support'],
  ['Copyright','./copyright'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="A practical, scenario-based learning system for people entering U.S. legal recruiting." />
  <meta name="robots" content="noindex,nofollow" />
  <title>Legal Recruiter Lab — Learn to Think Like a Legal Recruiter</title>
</head>
<body>
  <main>
    <nav class="nav">
      <a href="#top" aria-label="Recruiter Lab home">RECRUITER LAB</a>
      <span>Legal recruiting learning system</span>
    </nav>

    <section class="hero" id="top">
      <div class="eyebrow">LEGAL RECRUITER LAB</div>
      <h1>Learn to think like a<br/><em>legal recruiter.</em></h1>
      <p class="lede">A practical beginner's system for learning how strong legal recruiters read the market, evaluate talent, qualify searches and make better decisions with evidence.</p>
      <div class="actions">
        <a class="primary" href="#mission">Try the free mission</a>
        <a href="#field-guide">Explore the Field Guide</a>
        {checkoutEnabled ? <a class="test-checkout" href={recruiterLabCommerce.checkoutUrl} target="_blank" rel="noopener noreferrer">{checkoutCopy.cta}</a> : <span class="checkout-disabled">{checkoutCopy.cta}</span>}
      </div>
      <p class="test-note">{checkoutCopy.status} · {checkoutCopy.note}</p>
      <div class="proof"><span>6 learning paths</span><span>29 chapters</span><span>2 master cases</span><span>18 operator tools</span><span>90-day plan</span></div>
    </section>

    <section class="problem">
      <div><span>THE PROBLEM</span><h2>Recruiting is easy to describe.<br/>Harder to judge well.</h2></div>
      <div class="copy">
        <p>Beginners can learn sourcing tools quickly. The harder skill is knowing what matters: what a client actually needs, what a résumé really proves, whether motivation is durable and which questions reduce uncertainty.</p>
        <p>Legal Recruiter Lab trains that judgment through structured explanations, exercises, cases and operator tools instead of passive reading alone.</p>
      </div>
    </section>

    <section class="paths" id="curriculum">
      <header><span>CURRICULUM</span><h2>Six paths. One operator journey.</h2></header>
      <div class="pathgrid">
        {modules.map(([n,t,d]) => <article><b>{n}</b><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </section>

    <section class="mission" id="mission">
      <div class="mission-head"><div><span>FREE PRACTICE MISSION</span><h2>Spot the real signal.</h2><p>Three short decisions. Immediate feedback. No account required.</p></div><div class="xp"><strong id="xp">0</strong><small>XP</small></div></div>
      <div class="case">
        <p class="case-label">CANDIDATE SNAPSHOT</p>
        <blockquote>“Assisted senior partner on multiple cross-border M&A transactions in the technology sector.”</blockquote>
        <p>What is the best recruiter response?</p>
        <div class="choices" data-question="q1">
          <button data-correct="false">Strong M&A fit. Advance immediately.</button>
          <button data-correct="true">Ask what the candidate personally drafted or negotiated.</button>
          <button data-correct="false">Reject: “assisted” proves the candidate lacked ownership.</button>
        </div>
        <div class="feedback" id="q1-feedback" aria-live="polite"></div>
      </div>
      <div class="case">
        <p class="case-label">CLIENT INTAKE</p>
        <blockquote>“We need a finance associate. The market is crazy busy, so good luck finding anyone.”</blockquote>
        <p>Which question creates the most useful search signal first?</p>
        <div class="choices" data-question="q2">
          <button data-correct="false">What law school ranking do you require?</button>
          <button data-correct="true">Busy doing what specifically — and is the work lender-side or borrower-side?</button>
          <button data-correct="false">Can we post the role nationally?</button>
        </div>
        <div class="feedback" id="q2-feedback" aria-live="polite"></div>
      </div>
      <div class="case">
        <p class="case-label">CANDIDATE MOTIVATION</p>
        <blockquote>“My staffing partner assigned me to a deal I did not want last month. It has been a rough few weeks.”</blockquote>
        <p>What should you test next?</p>
        <div class="choices" data-question="q3">
          <button data-correct="true">Whether this is a recurring structural issue or a temporary frustration.</button>
          <button data-correct="false">Whether the candidate will accept a 10% raise.</button>
          <button data-correct="false">Whether the candidate can start within two weeks.</button>
        </div>
        <div class="feedback" id="q3-feedback" aria-live="polite"></div>
      </div>
      <div class="result" id="result"><span>MISSION STATUS</span><strong id="status">0 / 3 complete</strong><p>Complete all three decisions to reveal your Operator Readiness score.</p></div>
    </section>

    <section class="field" id="field-guide">
      <div class="field-intro"><span>FIELD GUIDE</span><h2>Thinking Like a Legal Recruiter</h2><p>A practical entry point for people learning international legal recruiting with a U.S.-market focus.</p></div>
      <div class="offer">
        <small>DIGITAL EDITION</small>
        <h3>{recruiterLabCommerce.productName}</h3>
        <strong>{recruiterLabCommerce.priceLabel}</strong>
        <ul>
          <li>29-chapter structured learning guide</li>
          <li>Exercises with suggested reasoning</li>
          <li>Two master case studies</li>
          <li>18 operator tools and reference frameworks</li>
          <li>First-90-days progression</li>
          <li>{recruiterLabCommerce.deliveryLabel}</li>
        </ul>
        {checkoutEnabled ? <a class="buy" href={recruiterLabCommerce.checkoutUrl} target="_blank" rel="noopener noreferrer">{checkoutCopy.cta}</a> : <span class="buy checkout-disabled">{checkoutCopy.cta}</span>}
        <p class="test-note inside">{checkoutCopy.status} · {checkoutCopy.note}</p>
      </div>
    </section>

    <section class="who">
      <header><span>WHO IT IS FOR</span><h2>Built for the beginning of the curve.</h2></header>
      <div class="who-grid">
        <article><h3>New recruiters</h3><p>Build a stronger mental model before relying on scripts, intuition or résumé keywords.</p></article>
        <article><h3>Career changers</h3><p>Learn how legal recruiting decisions differ from generalist talent acquisition.</p></article>
        <article><h3>Recruiting operators</h3><p>Use structured questions and reusable tools to reduce ambiguity in search work.</p></article>
      </div>
    </section>

    <section class="principle">
      <span>CORE PRINCIPLE</span>
      <blockquote>Do not trust the label. Test the underlying evidence.</blockquote>
      <p>The recurring discipline across the guide is evidence-first judgment: clarify work ownership, define the real client need, distinguish durable motivation from temporary frustration and avoid drawing conclusions before the facts support them.</p>
    </section>

    <section class="roadmap">
      <header><span>LEARNING ROADMAP</span><h2>Start with the guide. Practice with the system.</h2></header>
      <div class="tiers">
        <article class="entry"><small>{checkoutCopy.status}</small><h3>Field Guide</h3><strong>{recruiterLabCommerce.priceLabel}</strong><p>Structured guide, exercises, cases and operator tools.</p></article>
        <article><small>IN DEVELOPMENT</small><h3>Operator Lab</h3><strong>Interactive</strong><p>Scenario missions, scorecards, practice cases, progress tracking and certificate of completion.</p></article>
        <article><small>PLANNED</small><h3>90-Day Sprint</h3><strong>Applied</strong><p>Implementation path, AI practice prompts and portfolio-ready capstone work.</p></article>
      </div>
    </section>

    <section class="faq">
      <header><span>FAQ</span><h2>Before you start.</h2></header>
      <div class="faq-grid">
        <article><h3>Is this legal advice?</h3><p>No. It is an educational product about recruiting practice and professional judgment.</p></article>
        <article><h3>Is this a professional certification?</h3><p>No. Future completion credentials, if offered, will only represent completion of Recruiter Lab learning activities.</p></article>
        <article><h3>How is the product delivered?</h3><p>The Field Guide is delivered digitally through the configured checkout provider. The current commerce state is {recruiterLabCommerce.mode}.</p></article>
        <article><h3>Do I need recruiting experience?</h3><p>No. The guide is designed for people entering the field, while still emphasizing practical operating judgment.</p></article>
      </div>
    </section>

    <section class="prelaunch">
      <span>PRE-LAUNCH STATUS</span>
      <p>The product, policy surface and checkout adapter are connected. Live payments remain disabled until private merchant verification, live checkout activation and one controlled production purchase validate final delivery.</p>
    </section>

    <footer>
      <div><strong>RECRUITER LAB</strong><span>Legal Recruiter Lab · Educational product · not legal advice</span></div>
      <nav aria-label="Legal and support links">{policyLinks.map(([label,href]) => <a href={href}>{label}</a>)}</nav>
    </footer>
    <p class="flow-note">Flow note — Customer-facing commerce is provider-agnostic. Payment-provider changes are isolated to the Recruiter Lab commerce configuration while production sales remain gated.</p>
  </main>
<script is:inline>
  const answered = new Set(); let xp = 0;
  document.querySelectorAll('.choices').forEach(group => {
    group.querySelectorAll('button').forEach(btn => btn.addEventListener('click', () => {
      const q = group.dataset.question; if (answered.has(q)) return;
      answered.add(q); const ok = btn.dataset.correct === 'true';
      group.querySelectorAll('button').forEach(b => b.disabled = true);
      btn.classList.add(ok ? 'correct' : 'wrong');
      const fb = document.getElementById(q+'-feedback');
      fb.textContent = ok ? 'Correct — test the underlying evidence before trusting the label.' : 'Not quite — the stronger next move reduces ambiguity with job-related evidence.';
      if (ok) xp += 100; document.getElementById('xp').textContent = xp;
      document.getElementById('status').textContent = answered.size+' / 3 complete';
      if (answered.size === 3) document.querySelector('#result p').textContent = xp === 300 ? 'Operator Readiness: 100%. You consistently tested evidence before inference.' : 'Operator Readiness: '+Math.round(xp/3)+'%. Review the evidence-first pattern and try the scenarios again later.';
    }))
  })
</script>
</body>
</html>
<style is:global>
:root{--ink:#111;--paper:#f5f3ed;--line:#c8c5bb;--accent:#0d6b4d;--muted:#69675f;--panel:#fbfaf6}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}main{max-width:1500px;margin:auto;padding:0 28px}.nav{height:64px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--ink);font:700 10px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.06em}.nav a{color:inherit;text-decoration:none}.hero{min-height:calc(100vh - 64px);display:flex;flex-direction:column;justify-content:center;border-bottom:1px solid var(--ink);padding:60px 0}.eyebrow,.paths header span,.roadmap header span,.problem span,.mission-head span,.field-intro span,.who header span,.principle>span,.faq header span,.prelaunch span,.result span{font:700 10px ui-monospace,monospace;letter-spacing:.08em;color:var(--muted)}h1{font-size:clamp(68px,10vw,150px);line-height:.82;letter-spacing:-.07em;margin:36px 0;font-weight:600}h1 em{font-style:normal;color:var(--accent)}.lede{max-width:850px;font-size:22px;line-height:1.4}.actions{display:flex;gap:12px;margin:28px 0;flex-wrap:wrap}.actions a,.buy,.checkout-disabled{border:1px solid var(--ink);padding:13px 18px;text-decoration:none;color:inherit;font-size:12px;display:inline-block}.actions .primary{background:var(--ink);color:var(--paper)}.actions .test-checkout,.buy{border-color:var(--accent);color:var(--accent);font-weight:700}.checkout-disabled{opacity:.55;cursor:not-allowed}.test-note{margin:-12px 0 16px;font:700 9px ui-monospace,monospace;letter-spacing:.06em;color:var(--accent)}.test-note.inside{margin:12px 0 0}.proof{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}.proof span{border:1px solid var(--line);padding:8px 10px;font:600 10px ui-monospace,monospace}.problem,.field{display:grid;grid-template-columns:.85fr 1.15fr;gap:80px;padding:100px 0;border-bottom:1px solid var(--ink)}h2{font-size:clamp(44px,6vw,82px);line-height:.94;letter-spacing:-.055em;margin:18px 0}.copy p,.field-intro p,.principle p{font-size:19px;line-height:1.7;max-width:760px}.paths,.mission,.who,.roadmap,.faq,.principle,.prelaunch{padding:100px 0;border-bottom:1px solid var(--ink)}.paths header,.roadmap header,.who header,.faq header{display:grid;grid-template-columns:220px 1fr}.pathgrid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:50px;border-top:1px solid var(--ink)}.pathgrid article{padding:24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-height:210px}.pathgrid h3{font-size:28px;margin:45px 0 8px}.pathgrid p{color:var(--muted);line-height:1.5}.mission-head{display:flex;justify-content:space-between;gap:40px;align-items:end}.mission-head>div:first-child p{color:var(--muted)}.xp{text-align:right}.xp strong{display:block;font-size:72px;line-height:.8}.xp small{font:700 9px ui-monospace,monospace}.case{max-width:920px;margin:32px auto;padding:30px;border:1px solid var(--ink);background:var(--panel)}.case-label{font:700 9px ui-monospace,monospace;color:var(--accent)}blockquote{font-size:24px;line-height:1.35;margin:22px 0;border-left:3px solid var(--accent);padding-left:18px}.choices{display:grid;gap:10px}.choices button{text-align:left;border:1px solid var(--line);background:transparent;padding:15px;cursor:pointer;font-size:14px}.choices button:hover:not(:disabled){border-color:var(--ink)}.choices button.correct{border-color:var(--accent);background:#e8f3ed}.choices button.wrong{background:#f4e8e6}.feedback{min-height:22px;margin-top:14px;font-size:13px;color:var(--muted)}.result{max-width:920px;margin:32px auto 0;padding:26px;background:var(--ink);color:var(--paper)}.result strong{display:block;font-size:32px;margin:10px 0}.offer{border:1px solid var(--ink);background:var(--panel);padding:34px}.offer small{font:700 9px ui-monospace,monospace;color:var(--muted)}.offer h3{font-size:34px;margin:32px 0 12px}.offer>strong{font-size:48px}.offer ul{padding-left:20px;line-height:1.8;color:var(--muted)}.who-grid,.tiers,.faq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:50px}.who-grid article,.tiers article,.faq-grid article{border:1px solid var(--ink);padding:28px;min-height:240px}.who-grid h3,.faq-grid h3{font-size:24px;margin-top:60px}.who-grid p,.tiers p,.faq-grid p{line-height:1.6;color:var(--muted)}.principle blockquote{font-size:clamp(36px,5vw,72px);max-width:1100px;margin:34px 0}.tiers h3{font-size:30px;margin:60px 0 14px}.tiers strong{font-size:38px}.prelaunch{display:grid;grid-template-columns:220px 1fr;gap:20px}.prelaunch p{font-size:18px;line-height:1.65;margin:0;max-width:900px}footer{display:flex;justify-content:space-between;gap:30px;padding:34px 0 0;font:700 9px ui-monospace,monospace;color:var(--muted)}footer>div{display:grid;gap:6px}footer nav{display:flex;gap:14px;flex-wrap:wrap}footer a{color:inherit;text-decoration:none;border-bottom:1px solid var(--line)}.flow-note{max-width:900px;margin:18px 0 30px;font-size:10px;line-height:1.55;color:var(--muted)}@media(max-width:850px){main{padding:0 18px}.problem,.field,.paths header,.roadmap header,.who header,.faq header,.prelaunch{grid-template-columns:1fr;gap:20px}.pathgrid,.who-grid,.tiers,.faq-grid{grid-template-columns:1fr}.pathgrid article{border-right:0}h1{font-size:clamp(58px,18vw,100px)}.proof{margin-top:16px}.mission,.paths,.roadmap,.problem,.field,.who,.faq,.principle,.prelaunch{padding:64px 0}.case{padding:20px}.mission-head{align-items:flex-start}.xp strong{font-size:52px}footer{flex-direction:column}.field{gap:40px}}
</style>
