---
import CapabilityRegistry from '../components/CapabilityRegistry.astro';
import telemetry from '../data/telemetry_source.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f4f4f0" />
    <meta name="description" content="Lucas Capability OS — an evidence-driven public lab for reproducible AI systems, evaluation, automation and open technical learning." />
    <meta property="og:title" content="Lucas Capability OS — Evidence-driven AI systems" />
    <meta property="og:description" content="A public, sponsor-ready view of reproducible AI capabilities, verification depth and open technical work." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>Lucas Capability OS — Home Base</title>
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href="#home" aria-label="Lucas Capability OS home">
        <span class="brand-mark">LC</span>
        <span>Capability OS</span>
      </a>
      <nav aria-label="Primary">
        <a href="#system" data-i18n="nav.system">System</a>
        <a href="#capabilities" data-i18n="nav.registry">Registry</a>
        <a href="#evidence" data-i18n="nav.evidence">Evidence</a>
        <a href="./about/" data-i18n="nav.about">About</a>
        <a href="#sponsor" data-i18n="nav.sponsor">Sponsor</a>
      </nav>
      <div class="header-actions">
        <div class="language-switcher" role="group" aria-label="Language">
          <button type="button" data-lang="en" aria-label="English" aria-pressed="true" title="English">🇺🇸 <span>EN</span></button>
          <button type="button" data-lang="pt-BR" aria-label="Português do Brasil" aria-pressed="false" title="Português do Brasil">🇧🇷 <span>PT-BR</span></button>
        </div>
        <div class="operator-chip">
          <span>{telemetry.operator.label}</span>
          <img src="https://avatars.githubusercontent.com/u/322756565?v=4" alt="Operator avatar" loading="lazy" decoding="async" />
        </div>
      </div>
    </header>

    <main id="home">
      <section class="hero" aria-labelledby="home-title">
        <div class="hero-kicker" data-i18n="hero.kicker">Public system surface / 2026</div>
        <h1 id="home-title">Capability<br />Operating<br />System</h1>
        <div class="hero-bottom">
          <div>
            <p data-i18n="hero.tagline">Build, verify and preserve what can actually be reproduced.</p>
            <div class="hero-actions">
              <a class="cta primary" href="#system" data-i18n="hero.explore">Explore the system</a>
              <a class="cta sponsor" href="https://github.com/sponsors/lucasmateus334-oss" target="_blank" rel="noopener noreferrer" data-i18n="hero.sponsor">Sponsor this work</a>
            </div>
          </div>
          <dl>
            <div><dt data-i18n="hero.surfaceLabel">Surface</dt><dd data-i18n="hero.surfaceValue">Sanitized public snapshot</dd></div>
            <div><dt data-i18n="hero.sourceLabel">Source</dt><dd data-i18n="hero.sourceValue">Private canonical repository</dd></div>
            <div><dt data-i18n="hero.authorityLabel">Authority</dt><dd data-i18n="hero.authorityValue">None · presentation only</dd></div>
          </dl>
        </div>
      </section>

      <section class="metric-band" aria-label="Current system metrics">
        <article><span>01</span><strong>{telemetry.summary.materialized_candidate_count}</strong><p data-i18n="metrics.materialized">Materialized capabilities</p><code data-i18n="metrics.materializedNote">evidence-backed · eval required</code></article>
        <article><span>02</span><strong>{telemetry.summary.scaffold_unverified_count}</strong><p data-i18n="metrics.scaffold">Scaffold / unverified</p><code data-i18n="metrics.scaffoldNote">no synthetic promotion</code></article>
        <article><span>03</span><strong>{telemetry.summary.current_tier}</strong><p data-i18n="metrics.depth">Verification depth</p><code data-i18n="metrics.depthNote">active candidate</code></article>
        <article><span>04</span><strong>{telemetry.operator.level}</strong><p data-i18n="metrics.operator">Operator consolidation</p><code>{telemetry.operator.label}</code></article>
      </section>

      <section class="system-section" id="system">
        <header class="section-head">
          <span data-i18n="system.index">01 / SYSTEM STATE</span>
          <h2 data-i18n-html="system.title">Operational by evidence,<br />not by appearance.</h2>
        </header>
        <div class="system-grid">
          <div class="system-copy">
            <p class="lead" data-i18n="system.lead">The Home Base is a bounded read surface over the Capability OS. It exposes only states that can be represented without leaking private contracts, execution receipts or credentials.</p>
            <p data-i18n="system.body">Public publication cannot expand runtime authority. Planning, authorization, execution and promotion remain separate concerns.</p>
          </div>
          <dl class="facts">
            <div><dt data-i18n="system.promotion">Promotion rule</dt><dd>Green ≠ promotable</dd></div>
            <div><dt data-i18n="system.telemetry">Telemetry</dt><dd>{telemetry.mode}</dd></div>
            <div><dt>Schema</dt><dd>{telemetry.schema_version}</dd></div>
            <div><dt data-i18n="system.scope">Scope</dt><dd>{telemetry.source_scope}</dd></div>
          </dl>
        </div>
      </section>

      <section id="capabilities" class="registry-section"><CapabilityRegistry /></section>

      <section class="evidence-section" id="evidence">
        <header class="section-head"><span data-i18n="evidence.index">04 / EVIDENCE BOUNDARY</span><h2 data-i18n-html="evidence.title">What is shown.<br />What stays private.</h2></header>
        <div class="evidence-grid">
          <article><span class="number">A</span><h3 data-i18n="evidence.publicTitle">Public</h3><p data-i18n="evidence.publicBody">Capability names, coarse maturity state, verification tier and sanitized publication metadata.</p></article>
          <article><span class="number">B</span><h3 data-i18n="evidence.privateTitle">Private</h3><p data-i18n="evidence.privateBody">Execution receipts, review packets, credentials, internal evidence, implementation contracts and source provenance.</p></article>
          <article><span class="number">C</span><h3 data-i18n="evidence.gatedTitle">Gated</h3><p data-i18n="evidence.gatedBody">Promotion requires evidence, independent evaluation and an explicit owner decision. Technical green alone does not promote capability.</p></article>
        </div>
      </section>

      <section class="sponsor-section" id="sponsor">
        <div class="sponsor-intro">
          <span data-i18n="sponsor.index">05 / SUPPORT THE WORK</span>
          <h2 data-i18n-html="sponsor.title">Sponsor reproducible<br />AI capability research.</h2>
          <p data-i18n="sponsor.lead">Capability Lab turns experiments into evidence-backed, portable systems. Sponsorship helps fund public technical artifacts, evaluation, documentation and zero-cost-accessible learning paths.</p>
          <a class="cta sponsor large" href="https://github.com/sponsors/lucasmateus334-oss" target="_blank" rel="noopener noreferrer" data-i18n="sponsor.cta">View GitHub Sponsors</a>
        </div>
        <div class="sponsor-grid">
          <article><span>01</span><h3 data-i18n="sponsor.whyTitle">Why support it</h3><p data-i18n="sponsor.whyBody">Support a public effort focused on making AI systems understandable, testable and reproducible rather than opaque demonstrations.</p></article>
          <article><span>02</span><h3 data-i18n="sponsor.fundsTitle">What funding enables</h3><p data-i18n="sponsor.fundsBody">More evaluations, public documentation, interoperability experiments, reproducibility gates and educational releases.</p></article>
          <article><span>03</span><h3 data-i18n="sponsor.boundaryTitle">Sponsor boundary</h3><p data-i18n="sponsor.boundaryBody">Sponsors receive no access to private credentials, personal data, internal evidence or authority over technical validation outcomes.</p></article>
        </div>
      </section>

      <section class="tier-section" id="progress">
        <div class="tier-copy"><span data-i18n="tiers.index">06 / VERIFICATION DEPTH</span><h2 data-i18n="tiers.title">Progress without synthetic scores.</h2></div>
        <ol class="tier-list">{telemetry.tiers.map((tier, index) => (<li class:list={[tier.state === 'active_candidate' && 'is-current', tier.state === 'sealed' && 'is-done']}><span>{String(index + 1).padStart(2, '0')}</span><b>{tier.id}</b><em>{tier.label}</em><small>{tier.state}</small></li>))}</ol>
      </section>

      <footer class="footer"><div><span>Lucas Capability OS</span><span data-i18n="footer.boundary">Public presentation layer · no runtime authority</span></div><a href="#home" data-i18n="footer.top">Back to top ↑</a></footer>
      <p class="flow-note" data-i18n="footer.note">Flow note — This publication presents only a sanitized public view of the Home Base so the interface can be published via GitHub Pages without exposing the private repository. Flow: private canonical source → bounded public snapshot → GitHub Pages.</p>
    </main>

    <script is:inline>
      const translations = {
        en: {
          'nav.system':'System','nav.registry':'Registry','nav.evidence':'Evidence','nav.about':'About','nav.sponsor':'Sponsor','hero.kicker':'Public system surface / 2026','hero.tagline':'Build, verify and preserve what can actually be reproduced.','hero.explore':'Explore the system','hero.sponsor':'Sponsor this work','hero.surfaceLabel':'Surface','hero.surfaceValue':'Sanitized public snapshot','hero.sourceLabel':'Source','hero.sourceValue':'Private canonical repository','hero.authorityLabel':'Authority','hero.authorityValue':'None · presentation only','metrics.materialized':'Materialized capabilities','metrics.materializedNote':'evidence-backed · eval required','metrics.scaffold':'Scaffold / unverified','metrics.scaffoldNote':'no synthetic promotion','metrics.depth':'Verification depth','metrics.depthNote':'active candidate','metrics.operator':'Operator consolidation','system.index':'01 / SYSTEM STATE','system.title':'Operational by evidence,<br />not by appearance.','system.lead':'The Home Base is a bounded read surface over the Capability OS. It exposes only states that can be represented without leaking private contracts, execution receipts or credentials.','system.body':'Public publication cannot expand runtime authority. Planning, authorization, execution and promotion remain separate concerns.','system.promotion':'Promotion rule','system.telemetry':'Telemetry','system.scope':'Scope','evidence.index':'04 / EVIDENCE BOUNDARY','evidence.title':'What is shown.<br />What stays private.','evidence.publicTitle':'Public','evidence.publicBody':'Capability names, coarse maturity state, verification tier and sanitized publication metadata.','evidence.privateTitle':'Private','evidence.privateBody':'Execution receipts, review packets, credentials, internal evidence, implementation contracts and source provenance.','evidence.gatedTitle':'Gated','evidence.gatedBody':'Promotion requires evidence, independent evaluation and an explicit owner decision. Technical green alone does not promote capability.','sponsor.index':'05 / SUPPORT THE WORK','sponsor.title':'Sponsor reproducible<br />AI capability research.','sponsor.lead':'Capability Lab turns experiments into evidence-backed, portable systems. Sponsorship helps fund public technical artifacts, evaluation, documentation and zero-cost-accessible learning paths.','sponsor.cta':'View GitHub Sponsors','sponsor.whyTitle':'Why support it','sponsor.whyBody':'Support a public effort focused on making AI systems understandable, testable and reproducible rather than opaque demonstrations.','sponsor.fundsTitle':'What funding enables','sponsor.fundsBody':'More evaluations, public documentation, interoperability experiments, reproducibility gates and educational releases.','sponsor.boundaryTitle':'Sponsor boundary','sponsor.boundaryBody':'Sponsors receive no access to private credentials, personal data, internal evidence or authority over technical validation outcomes.','tiers.index':'06 / VERIFICATION DEPTH','tiers.title':'Progress without synthetic scores.','footer.boundary':'Public presentation layer · no runtime authority','footer.top':'Back to top ↑','footer.note':'Flow note — This publication presents only a sanitized public view of the Home Base so the interface can be published via GitHub Pages without exposing the private repository. Flow: private canonical source → bounded public snapshot → GitHub Pages.'
        },
        'pt-BR': {
          'nav.system':'Sistema','nav.registry':'Registro','nav.evidence':'Evidências','nav.about':'Sobre','nav.sponsor':'Patrocinar','hero.kicker':'Superfície pública do sistema / 2026','hero.tagline':'Construir, verificar e preservar o que realmente pode ser reproduzido.','hero.explore':'Explorar o sistema','hero.sponsor':'Patrocinar este trabalho','hero.surfaceLabel':'Superfície','hero.surfaceValue':'Snapshot público sanitizado','hero.sourceLabel':'Fonte','hero.sourceValue':'Repositório canônico privado','hero.authorityLabel':'Autoridade','hero.authorityValue':'Nenhuma · apenas apresentação','metrics.materialized':'Capacidades materializadas','metrics.materializedNote':'baseadas em evidência · avaliação necessária','metrics.scaffold':'Estrutura / não verificada','metrics.scaffoldNote':'sem promoção sintética','metrics.depth':'Profundidade de verificação','metrics.depthNote':'candidato ativo','metrics.operator':'Consolidação do operador','system.index':'01 / ESTADO DO SISTEMA','system.title':'Operacional por evidência,<br />não por aparência.','system.lead':'A Home Base é uma superfície de leitura delimitada sobre o Capability OS. Ela expõe apenas estados que podem ser representados sem vazar contratos privados, recibos de execução ou credenciais.','system.body':'A publicação pública não pode ampliar autoridade de runtime. Planejamento, autorização, execução e promoção permanecem separados.','system.promotion':'Regra de promoção','system.telemetry':'Telemetria','system.scope':'Escopo','evidence.index':'04 / LIMITE DE EVIDÊNCIAS','evidence.title':'O que é mostrado.<br />O que permanece privado.','evidence.publicTitle':'Público','evidence.publicBody':'Nomes de capacidades, estado de maturidade em alto nível, nível de verificação e metadados sanitizados de publicação.','evidence.privateTitle':'Privado','evidence.privateBody':'Recibos de execução, pacotes de revisão, credenciais, evidências internas, contratos de implementação e proveniência das fontes.','evidence.gatedTitle':'Controlado','evidence.gatedBody':'A promoção exige evidência, avaliação independente e decisão explícita do proprietário. Estar tecnicamente green não promove uma capacidade.','sponsor.index':'05 / APOIE O TRABALHO','sponsor.title':'Patrocine pesquisa em<br />capacidades de IA reproduzíveis.','sponsor.lead':'O Capability Lab transforma experimentos em sistemas portáveis e sustentados por evidências. O patrocínio ajuda a financiar artefatos técnicos públicos, avaliações, documentação e trilhas de aprendizado acessíveis com custo zero.','sponsor.cta':'Ver GitHub Sponsors','sponsor.whyTitle':'Por que apoiar','sponsor.whyBody':'Apoie um esforço público focado em tornar sistemas de IA compreensíveis, testáveis e reproduzíveis, em vez de demonstrações opacas.','sponsor.fundsTitle':'O que o apoio viabiliza','sponsor.fundsBody':'Mais avaliações, documentação pública, experimentos de interoperabilidade, gates de reprodutibilidade e lançamentos educacionais.','sponsor.boundaryTitle':'Limite do patrocinador','sponsor.boundaryBody':'Patrocinadores não recebem acesso a credenciais privadas, dados pessoais, evidências internas ou autoridade sobre resultados de validação técnica.','tiers.index':'06 / PROFUNDIDADE DE VERIFICAÇÃO','tiers.title':'Progresso sem pontuações sintéticas.','footer.boundary':'Camada pública de apresentação · sem autoridade de runtime','footer.top':'Voltar ao topo ↑','footer.note':'Nota de fluxo — Esta publicação apresenta apenas uma visão pública sanitizada da Home Base para disponibilizar a interface via GitHub Pages sem expor o repositório privado. Fluxo: fonte canônica privada → snapshot público delimitado → GitHub Pages.'
        }
      };
      const applyLanguage = (lang) => {
        const selected = translations[lang] ? lang : 'en';
        document.documentElement.lang = selected;
        document.querySelectorAll('[data-i18n]').forEach((el) => { const key = el.dataset.i18n; if (translations[selected][key]) el.textContent = translations[selected][key]; });
        document.querySelectorAll('[data-i18n-html]').forEach((el) => { const key = el.dataset.i18nHtml; if (translations[selected][key]) el.innerHTML = translations[selected][key]; });
        document.querySelectorAll('[data-lang]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.lang === selected)));
        try { localStorage.setItem('capability-os-language', selected); } catch {}
        window.dispatchEvent(new CustomEvent('capability:language', { detail: { lang: selected } }));
      };
      const preferred = (() => { try { return localStorage.getItem('capability-os-language'); } catch { return null; } })();
      applyLanguage(preferred || (navigator.language && navigator.language.toLowerCase().startsWith('pt') ? 'pt-BR' : 'en'));
      document.querySelectorAll('[data-lang]').forEach((button) => button.addEventListener('click', () => applyLanguage(button.dataset.lang)));
    </script>
  </body>
</html>

<style is:global>
  :root{--ink:#11110f;--paper:#f4f4f0;--line:#c8c8c1;--muted:#6f6f69;--green:#17865b;--sponsor:#7a4fd3}
  *{box-sizing:border-box} html{scroll-behavior:smooth;background:var(--paper)} body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased} a{color:inherit}
  .masthead{position:sticky;top:0;z-index:20;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:64px;padding:0 28px;border-bottom:1px solid #111;background:rgba(244,244,240,.94);backdrop-filter:blur(10px)}
  .brand{display:inline-flex;align-items:center;gap:10px;width:max-content;text-decoration:none;font-size:12px;font-weight:700;text-transform:uppercase}.brand-mark{display:grid;place-items:center;width:28px;height:28px;border:1px solid #111;font:700 10px ui-monospace,SFMono-Regular,Menlo,monospace}.masthead nav{display:flex;gap:18px}.masthead nav a{text-decoration:none;font-size:11px;color:#5f5f5a}.masthead nav a:hover{color:#111}
  .header-actions{justify-self:end;display:flex;align-items:center;gap:14px}.language-switcher{display:flex;border:1px solid #c9c9c2;border-radius:999px;padding:2px;background:#fff}.language-switcher button{border:0;background:transparent;border-radius:999px;padding:5px 8px;font:700 9px ui-monospace,SFMono-Regular,Menlo,monospace;cursor:pointer;color:#666}.language-switcher button[aria-pressed="true"]{background:#111;color:#fff}.operator-chip{display:flex;align-items:center;gap:10px;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:#666661}.operator-chip img{width:30px;height:30px;border-radius:50%;object-fit:cover;filter:grayscale(1) contrast(1.1)}
  main{width:min(100%,1600px);margin:0 auto;padding:0 28px 42px}.hero{min-height:calc(100vh - 64px);display:grid;grid-template-rows:auto 1fr auto;padding:28px 0 36px;border-bottom:1px solid #111}.hero-kicker{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:#686863}.hero h1{align-self:center;margin:34px 0;font-size:clamp(76px,13vw,210px);line-height:.78;letter-spacing:-.085em;font-weight:600;text-transform:uppercase}.hero-bottom{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:end}.hero-bottom p{max-width:720px;margin:0;font-size:clamp(22px,2.6vw,38px);line-height:1.05;letter-spacing:-.035em}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}.cta{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border:1px solid #111;text-decoration:none;font-size:11px;font-weight:700;text-transform:uppercase}.cta.primary{background:#111;color:#fff}.cta.sponsor{border-color:var(--sponsor);color:var(--sponsor)}.cta.sponsor:hover{background:var(--sponsor);color:#fff}.cta.large{min-height:50px;margin-top:26px}.hero-bottom dl{margin:0;display:grid}.hero-bottom dl div{display:grid;grid-template-columns:120px 1fr;gap:20px;padding:10px 0;border-top:1px solid var(--line);font-size:11px}.hero-bottom dt{color:var(--muted)}.hero-bottom dd{margin:0;text-align:right}
  .metric-band{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #111}.metric-band article{min-height:200px;padding:18px 20px 22px 0;border-right:1px solid var(--line)}.metric-band article+article{padding-left:20px}.metric-band article:last-child{border-right:0}.metric-band span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#777772}.metric-band strong{display:block;margin-top:24px;font-size:clamp(54px,6vw,96px);line-height:.9;letter-spacing:-.06em;font-weight:500}.metric-band p{margin:18px 0 5px;font-size:12px}.metric-band code{font:500 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#797973}
  .system-section,.evidence-section,.tier-section,.sponsor-section{padding:86px 0;border-bottom:1px solid #111}.section-head{display:grid;grid-template-columns:220px 1fr;gap:38px;align-items:start;margin-bottom:58px}.section-head>span,.tier-copy>span,.sponsor-intro>span{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#6c6c67}.section-head h2,.tier-copy h2,.sponsor-intro h2{margin:0;font-size:clamp(44px,6vw,88px);line-height:.94;letter-spacing:-.065em;font-weight:500}.system-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:80px;margin-left:258px}.system-copy{max-width:650px}.system-copy p{margin:0 0 20px;font-size:14px;line-height:1.65;color:#565651}.system-copy .lead{font-size:19px;line-height:1.45;color:#171715}.facts{margin:0}.facts div{display:grid;grid-template-columns:1fr auto;gap:24px;padding:13px 0;border-top:1px solid var(--line)}.facts dt{font-size:11px;color:#70706a}.facts dd{margin:0;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.registry-section{padding:86px 0}.evidence-grid,.sponsor-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #111}.evidence-grid article,.sponsor-grid article{min-height:270px;padding:22px 28px 26px 0;border-right:1px solid var(--line)}.evidence-grid article+article,.sponsor-grid article+article{padding-left:28px}.evidence-grid article:last-child,.sponsor-grid article:last-child{border-right:0}.number,.sponsor-grid article>span{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#6c6c67}.evidence-grid h3,.sponsor-grid h3{margin:54px 0 16px;font-size:30px;letter-spacing:-.04em}.evidence-grid p,.sponsor-grid p{max-width:400px;margin:0;font-size:13px;line-height:1.65;color:#5d5d58}.sponsor-section{background:linear-gradient(180deg,rgba(122,79,211,.045),transparent 55%)}.sponsor-intro{max-width:1050px;margin-bottom:58px}.sponsor-intro h2{margin-top:16px}.sponsor-intro p{max-width:760px;font-size:16px;line-height:1.6;color:#50504b}.tier-section{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px}.tier-copy h2{margin-top:18px;font-size:clamp(42px,5vw,72px)}.tier-list{list-style:none;margin:0;padding:0;border-top:1px solid #111}.tier-list li{display:grid;grid-template-columns:48px 56px 1fr auto;align-items:center;gap:18px;min-height:72px;border-bottom:1px solid var(--line)}.tier-list li span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#85857f}.tier-list li b{font-size:14px}.tier-list li em{font-style:normal;font-size:13px}.tier-list li small{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:#75756f}.tier-list li.is-current b,.tier-list li.is-current small{color:var(--green)}.footer{display:flex;justify-content:space-between;gap:30px;padding:24px 0 0}.footer div{display:flex;gap:18px;flex-wrap:wrap}.footer span,.footer a{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;color:#696963}.footer a{text-decoration:none}.flow-note{max-width:940px;margin:18px 0 0;font-size:10px;line-height:1.6;color:#7a7a74}
  @media(max-width:1080px){.masthead{grid-template-columns:1fr auto}.masthead nav{display:none}.operator-chip span{display:none}.hero{min-height:auto}.hero h1{margin:90px 0}.hero-bottom,.system-grid,.tier-section{grid-template-columns:1fr}.system-grid{margin-left:0}.metric-band{grid-template-columns:1fr 1fr}.section-head{grid-template-columns:1fr;gap:18px}.evidence-grid,.sponsor-grid{grid-template-columns:1fr}.evidence-grid article,.evidence-grid article+article,.sponsor-grid article,.sponsor-grid article+article{padding-left:0;border-right:0;border-bottom:1px solid var(--line)}}
  @media(max-width:640px){.masthead{padding:0 18px}.language-switcher button span{display:none}main{padding:0 18px 32px}.hero h1{font-size:clamp(64px,20vw,112px);line-height:.82}.hero-bottom{gap:36px}.hero-bottom dl div{grid-template-columns:90px 1fr}.metric-band{grid-template-columns:1fr}.metric-band article,.metric-band article+article{padding:18px 0;border-right:0;border-bottom:1px solid var(--line)}.system-section,.evidence-section,.tier-section,.registry-section,.sponsor-section{padding:58px 0}.tier-list li{grid-template-columns:36px 44px 1fr;gap:12px}.tier-list li small{grid-column:3}}
</style>