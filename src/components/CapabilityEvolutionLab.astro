<section class="evolution-lab" id="experiment" aria-labelledby="experiment-title">
  <header class="lab-head">
    <span>03 / PUBLIC EXPERIMENT</span>
    <div>
      <p class="eyebrow">Capability Evolution Lab · Experiment 01</p>
      <h2 id="experiment-title">Can a method make AI<br />work measurably better?</h2>
      <p class="intro">Judge three answers to the same messy task without knowing how they were produced. Reveal the methods only after your choice.</p>
    </div>
  </header>

  <div class="lab-shell" data-evolution-lab>
    <div class="challenge">
      <div class="challenge-meta"><span>THE SAME INPUT</span><b>01 / 04</b></div>
      <p class="challenge-text">A small team is launching a community mentoring program in 30 days. Build a practical plan that makes progress visible, handles uncertainty, and can be reviewed by someone who was not in the room.</p>
      <button type="button" class="begin" data-begin>Start blind test →</button>
    </div>

    <div class="blind-stage" data-stage hidden>
      <div class="stage-head">
        <div><span>BLIND COMPARISON</span><strong>Pick the strongest answer</strong></div>
        <small>No method labels until you vote.</small>
      </div>
      <div class="answer-grid" data-answer-grid></div>
      <div class="rubric">
        <span>JUDGE ON</span>
        <b>Clarity</b><b>Traceability</b><b>Uncertainty</b><b>Reviewability</b>
      </div>
    </div>

    <div class="reveal" data-reveal hidden aria-live="polite">
      <div class="reveal-kicker"><span>METHOD REVEALED</span><b>Your choice: <strong data-choice></strong></b></div>
      <div class="method-grid" data-method-grid></div>
      <div class="thesis">
        <span>C LAB THESIS UNDER TEST</span>
        <p>Capability does not improve only because a stronger model is added. It improves when context, decomposition, evidence, critique and explicit evaluation are designed as a repeatable operating loop.</p>
      </div>
      <button type="button" class="again" data-again>Run again ↺</button>
    </div>

    <p class="lab-note">Public experiment v1 uses fixed, disclosed benchmark outputs and randomizes presentation order locally in your browser. It does not claim statistical validation and does not collect visitor data.</p>
  </div>
</section>

<script>
  const variants = [
    {
      id: 'baseline',
      method: 'Unaided baseline',
      badge: 'BASELINE',
      score: '1.9 / 4',
      text: 'Create a launch checklist, recruit mentors and participants, set dates, promote the program, run kickoff, then survey participants at the end. Assign owners to each workstream and meet weekly to track progress.',
      why: 'Useful direction, but weak evidence links, no explicit uncertainty handling and limited review structure.'
    },
    {
      id: 'single',
      method: 'Single-pass AI',
      badge: 'AI · ONE PASS',
      score: '2.8 / 4',
      text: 'Split the 30 days into setup, recruitment, matching and launch. Track applications, match rate, attendance and satisfaction. Use a shared dashboard, weekly risk review and participant feedback. Define owners, deadlines and escalation points.',
      why: 'More complete and structured, but the reasoning path and evidence behind choices remain mostly implicit.'
    },
    {
      id: 'clab',
      method: 'C Lab operating loop',
      badge: 'AI + METHOD',
      score: '3.8 / 4',
      text: 'Define the launch claim first: “a safe, usable mentoring pilot can start in 30 days.” Break it into five testable conditions: mentor supply, participant demand, matching quality, safeguarding readiness and operating continuity. For each condition, name an owner, evidence source, minimum threshold, open uncertainty and review date. Run weekly red-team checks against the evidence, log exceptions, and publish a launch/no-launch decision packet that another reviewer can reproduce from source records.',
      why: 'Makes claims, evidence, thresholds, uncertainty and independent review explicit instead of treating output quality as a single generation step.'
    }
  ];

  const lab = document.querySelector<HTMLElement>('[data-evolution-lab]');
  if (lab) {
    const stage = lab.querySelector<HTMLElement>('[data-stage]');
    const reveal = lab.querySelector<HTMLElement>('[data-reveal]');
    const grid = lab.querySelector<HTMLElement>('[data-answer-grid]');
    const methodGrid = lab.querySelector<HTMLElement>('[data-method-grid]');
    const choice = lab.querySelector<HTMLElement>('[data-choice]');
    const begin = lab.querySelector<HTMLButtonElement>('[data-begin]');
    const again = lab.querySelector<HTMLButtonElement>('[data-again]');

    const shuffle = <T,>(items: T[]) => {
      const copy = [...items];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const left = copy[i];
        const right = copy[j];
        if (left === undefined || right === undefined) continue;
        copy[i] = right;
        copy[j] = left;
      }
      return copy;
    };

    const start = () => {
      const ordered = shuffle(variants);
      if (grid) {
        grid.innerHTML = '';
        ordered.forEach((variant, index) => {
          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'blind-card';
          card.dataset.variant = variant.id;
          card.innerHTML = `<span class="answer-id">ANSWER ${String.fromCharCode(65 + index)}</span><p>${variant.text}</p><span class="choose">Choose this answer →</span>`;
          card.addEventListener('click', () => vote(variant.id, String.fromCharCode(65 + index), ordered));
          grid.appendChild(card);
        });
      }
      if (stage) stage.hidden = false;
      if (reveal) reveal.hidden = true;
      stage?.scrollIntoView({behavior:'smooth', block:'start'});
    };

    const vote = (id: string, letter: string, ordered: typeof variants) => {
      const picked = variants.find((v) => v.id === id);
      if (choice && picked) choice.textContent = `${letter} · ${picked.method}`;
      if (methodGrid) {
        methodGrid.innerHTML = '';
        ordered.forEach((variant, index) => {
          const article = document.createElement('article');
          article.className = variant.id === id ? 'method-card is-picked' : 'method-card';
          article.innerHTML = `<div><span>ANSWER ${String.fromCharCode(65 + index)}</span><b>${variant.badge}</b></div><h3>${variant.method}</h3><strong>${variant.score}</strong><p>${variant.why}</p>`;
          methodGrid.appendChild(article);
        });
      }
      if (reveal) reveal.hidden = false;
      reveal?.scrollIntoView({behavior:'smooth', block:'start'});
    };

    begin?.addEventListener('click', start);
    again?.addEventListener('click', start);
  }
</script>

