  .blind-stage,.reveal{padding:34px}.stage-head,.reveal-kicker{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:24px}.stage-head div{display:grid;gap:8px}.stage-head strong{font-size:24px}.stage-head small{color:#9b9b94}
  .answer-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #555;border-left:1px solid #555}.blind-card{min-height:390px;display:flex;flex-direction:column;align-items:flex-start;padding:26px;border:0;border-right:1px solid #555;border-bottom:1px solid #555;background:#151513;color:#f5f5f0;text-align:left;cursor:pointer;transition:transform .2s ease,background .2s ease}.blind-card:hover{background:#20201d;transform:translateY(-3px)}.answer-id,.choose{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;color:#a9a9a2}.blind-card p{margin:46px 0 30px;font-size:17px;line-height:1.55}.choose{margin-top:auto;color:#fff}
  .rubric{display:grid;grid-template-columns:180px repeat(4,1fr);gap:18px;padding:20px 0 0}.rubric b{font-size:11px;text-transform:uppercase;color:#c9c9c2}
  .reveal{border-top:1px solid #3a3a37}.method-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#4b4b47;border:1px solid #4b4b47}.method-card{min-height:290px;padding:24px;background:#171715}.method-card.is-picked{outline:2px solid #f5f5f0;outline-offset:-2px}.method-card>div{display:flex;justify-content:space-between;gap:12px}.method-card span,.method-card b{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#9b9b94}.method-card h3{margin:46px 0 10px;font-size:24px}.method-card>strong{font-size:48px;letter-spacing:-.05em}.method-card p{margin:18px 0 0;font-size:12px;line-height:1.6;color:#bdbdb6}.thesis{display:grid;grid-template-columns:180px 1fr;gap:34px;margin:34px 0;padding:30px 0;border-top:1px solid #4b4b47;border-bottom:1px solid #4b4b47}.thesis p{max-width:900px;margin:0;font-size:22px;line-height:1.35;letter-spacing:-.02em}
  .lab-note{margin:0;padding:18px 34px;border-top:1px solid #3a3a37;font:500 9px ui-monospace,SFMono-Regular,Menlo,monospace;line-height:1.5;color:#8f8f89}
  [hidden]{display:none!important}
  @media(max-width:980px){.lab-head{grid-template-columns:1fr}.challenge{grid-template-columns:1fr}.answer-grid,.method-grid{grid-template-columns:1fr}.blind-card{min-height:260px}.rubric{grid-template-columns:1fr 1fr}.thesis{grid-template-columns:1fr}}
  @media(max-width:640px){.evolution-lab{padding:58px 0}.blind-stage,.reveal,.challenge{padding:22px}.lab-note{padding:16px 22px}.stage-head,.reveal-kicker{align-items:flex-start;flex-direction:column}.rubric{grid-template-columns:1fr 1fr}.blind-card p{margin-top:28px}.thesis p{font-size:18px}}
</style>
