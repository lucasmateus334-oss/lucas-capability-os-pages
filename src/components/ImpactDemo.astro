  .scenario-tabs button:last-child{border-right:0}.scenario-tabs button:hover{background:#242421}.scenario-tabs button:focus-visible{outline:2px solid #fff;outline-offset:-4px}
  .scenario-tabs button[aria-selected="true"]{background:var(--accent);color:#fff}
  .tab-index{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;opacity:.7}.tab-copy{display:grid;gap:5px}.tab-copy strong{font-size:13px}.tab-copy small{font-size:10px;font-weight:400;opacity:.72}.tab-arrow{font-size:18px;transition:transform .2s ease}.scenario-tabs button:hover .tab-arrow,.scenario-tabs button[aria-selected="true"] .tab-arrow{transform:translateX(4px)}

  .scenario-context{position:relative;padding:46px 44px 40px;border-bottom:1px solid #d4d4cf;background:linear-gradient(120deg,var(--accent-soft),#fff 68%);overflow:hidden}
  .scenario-context:after{content:'';position:absolute;right:-70px;top:-100px;width:300px;height:300px;border-radius:50%;border:70px solid color-mix(in srgb,var(--accent) 18%,transparent);pointer-events:none}
  .context-kicker{display:flex;justify-content:space-between;gap:20px;position:relative;z-index:1}.context-kicker span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--accent-ink)}
  .scenario-context h3{position:relative;z-index:1;max-width:1080px;margin:18px 0 18px;font-size:clamp(32px,4.5vw,62px);line-height:.96;letter-spacing:-.05em;font-weight:500}
  .scenario-context>p{position:relative;z-index:1;max-width:780px;margin:0;font-size:15px;line-height:1.68;color:#414541}
  .start-button{position:relative;z-index:1;margin-top:28px;min-height:44px;padding:0 17px;border:0;background:var(--accent);color:#fff;font-size:11px;font-weight:700;cursor:pointer}.start-button span{display:inline-block;margin-left:8px}.start-button:hover{filter:brightness(.92)}

  .journey{scroll-margin-top:80px;background:#f7f7f4}
  .journey-head{display:grid;grid-template-columns:220px 1fr;gap:28px;align-items:end;padding:22px 26px;border-bottom:1px solid #c7c7c1}.journey-head>div:first-child{display:flex;justify-content:space-between;gap:10px;grid-column:1/-1}.journey-head span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em;color:#72726c}.journey-head strong{font:600 11px ui-monospace,SFMono-Regular,Menlo,monospace}.journey-head b{color:var(--accent)}
  .progress-track{grid-column:1/-1;height:4px;background:#ddd}.progress-track span{display:block;width:25%;height:100%;background:var(--accent);transition:width .28s ease}

