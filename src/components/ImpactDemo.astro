  .impact-flow button:hover{background:#ecece7}.impact-flow button:focus-visible{outline:2px solid var(--accent);outline-offset:-4px}.impact-flow button[aria-current="step"]{background:var(--accent);color:#fff}
  .step-number,.step-state{display:block;font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.07em}.step-number{opacity:.65}.step-state{margin-top:8px;color:var(--accent);opacity:.95}.impact-flow button[aria-current="step"] .step-state{color:#fff}
  .impact-flow strong{display:block;margin:48px 0 12px;font-size:19px}.impact-flow p{margin:0;font-size:12px;line-height:1.62;color:#5a5e58}.impact-flow button[aria-current="step"] p{color:rgba(255,255,255,.84)}

  .active-step{display:grid;grid-template-columns:72px 1fr auto;gap:24px;align-items:center;padding:24px 28px;border-bottom:1px solid #111;background:#111;color:#fff}
  .active-marker{display:grid;place-items:center;width:54px;height:54px;border:1px solid #555;border-radius:50%;font:600 11px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--accent-soft)}
  .active-kicker{display:block;margin-bottom:7px;font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.08em;color:var(--accent-soft)}
  .active-step p{max-width:760px;margin:0;font-size:14px;line-height:1.55;color:#e7e7e2}.next-step{min-height:42px;padding:0 16px;border:1px solid #777;background:transparent;color:#fff;font-size:11px;font-weight:700;cursor:pointer}.next-step:hover{background:#fff;color:#111}

  .impact-value{display:grid;grid-template-columns:1.15fr .85fr;border-bottom:1px solid #111;transition:box-shadow .25s ease}.impact-value.is-revealed{box-shadow:inset 0 6px 0 var(--accent)}
  .impact-value>div{padding:34px}.impact-value>div:first-child{border-right:1px solid #c7c7c1}.impact-value span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.07em;color:var(--accent-ink)}
  .impact-value p{max-width:680px;margin:16px 0 0;font-size:17px;line-height:1.52}.value-main{background:var(--accent-soft)}.value-main p{font-size:clamp(20px,2.1vw,31px);line-height:1.2;letter-spacing:-.025em}.value-method{background:#fff}
  .impact-note{margin:0;padding:16px 28px;font-size:10px;line-height:1.55;color:#6c716b;background:#f2f2ee}

  @media(max-width:980px){.impact-head{grid-template-columns:1fr;gap:18px}.scenario-picker{grid-template-columns:1fr}.picker-label{display:none}.scenario-tabs{grid-template-columns:1fr}.scenario-tabs button{min-height:72px;border-right:0;border-bottom:1px solid #3c3c39}.scenario-tabs button:last-child{border-bottom:0}.impact-flow{grid-template-columns:1fr 1fr}.impact-flow li:nth-child(2){border-right:0}.impact-flow li:nth-child(-n+2){border-bottom:1px solid #c7c7c1}.active-step{grid-template-columns:60px 1fr}.next-step{grid-column:2;width:max-content}.impact-value{grid-template-columns:1fr}.impact-value>div:first-child{border-right:0;border-bottom:1px solid #c7c7c1}}
  @media(max-width:640px){.impact-demo{padding:52px 0 70px}.impact-head h2{font-size:clamp(48px,16vw,70px)}.scenario-context{padding:30px 20px}.context-kicker{flex-direction:column;gap:6px}.scenario-context:after{display:none}.scenario-context h3{font-size:clamp(32px,11vw,48px)}.impact-flow{grid-template-columns:1fr}.impact-flow li,.impact-flow li:nth-child(2){border-right:0;border-bottom:1px solid #c7c7c1}.impact-flow li:last-child{border-bottom:0}.impact-flow button{min-height:0;padding:22px 20px}.impact-flow strong{margin:24px 0 9px}.active-step{grid-template-columns:48px 1fr;gap:15px;padding:22px 20px}.active-marker{width:42px;height:42px}.next-step{grid-column:1/-1;width:100%}.impact-value>div{padding:26px 20px}.impact-note{padding:15px 20px}}
  @media(prefers-reduced-motion:reduce){.scenario-tabs button,.tab-arrow,.progress-track span{transition:none}.journey{scroll-behavior:auto}}
</style>
