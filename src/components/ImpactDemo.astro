  .impact-head h2{max-width:1050px;margin:0;font-size:clamp(44px,6vw,88px);line-height:.94;letter-spacing:-.065em;font-weight:500}
  .impact-head .intro{max-width:760px;margin:24px 0 0;font-size:15px;line-height:1.65;text-transform:none;letter-spacing:0;color:#565651}
  .impact-shell{border:1px solid #111;background:#ecefe9}
  .scenario-tabs{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid #111}
  .scenario-tabs button{min-height:54px;padding:0 18px;border:0;border-right:1px solid #b8bcb6;background:transparent;color:#4d514d;font:600 11px Arial,Helvetica,sans-serif;text-align:left;cursor:pointer}
  .scenario-tabs button:last-child{border-right:0}.scenario-tabs button[aria-selected="true"]{background:#151715;color:#fff}.scenario-tabs button:focus-visible{outline:2px solid #111;outline-offset:-4px}
  .scenario-context{padding:34px;border-bottom:1px solid #b8bcb6}.scenario-label,.impact-flow span,.impact-value span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.07em;color:#5d665f}
  .scenario-context h3{max-width:1100px;margin:14px 0 16px;font-size:clamp(28px,4vw,54px);line-height:1;letter-spacing:-.045em;font-weight:500}
  .scenario-context p{max-width:840px;margin:0;font-size:14px;line-height:1.7;color:#525751}
  .impact-flow{display:grid;grid-template-columns:repeat(4,1fr);margin:0;padding:0;list-style:none;border-bottom:1px solid #b8bcb6}
  .impact-flow li{min-height:255px;padding:26px;border-right:1px solid #b8bcb6}.impact-flow li:last-child{border-right:0}.impact-flow strong{display:block;margin:44px 0 12px;font-size:18px}.impact-flow p{margin:0;font-size:13px;line-height:1.65;color:#555a54}
  .impact-value{display:grid;grid-template-columns:1fr 1fr}.impact-value>div{padding:26px 30px}.impact-value>div:first-child{border-right:1px solid #b8bcb6}.impact-value p{max-width:650px;margin:14px 0 0;font-size:15px;line-height:1.6}
  .impact-note{margin:0;padding:18px 30px;border-top:1px solid #b8bcb6;font-size:10px;line-height:1.55;color:#6c716b;background:rgba(255,255,255,.25)}
  @media(max-width:980px){.impact-head{grid-template-columns:1fr;gap:18px}.impact-flow{grid-template-columns:1fr 1fr}.impact-flow li:nth-child(2){border-right:0}.impact-flow li:nth-child(-n+2){border-bottom:1px solid #b8bcb6}}
  @media(max-width:640px){.impact-demo{padding:58px 0}.scenario-tabs{grid-template-columns:1fr}.scenario-tabs button{border-right:0;border-bottom:1px solid #b8bcb6}.scenario-tabs button:last-child{border-bottom:0}.scenario-context{padding:24px 20px}.impact-flow{grid-template-columns:1fr}.impact-flow li,.impact-flow li:nth-child(2){min-height:0;padding:24px 20px;border-right:0;border-bottom:1px solid #b8bcb6}.impact-flow li:last-child{border-bottom:0}.impact-flow strong{margin:24px 0 10px}.impact-value{grid-template-columns:1fr}.impact-value>div{padding:24px 20px}.impact-value>div:first-child{border-right:0;border-bottom:1px solid #b8bcb6}.impact-note{padding:16px 20px}}
</style>
