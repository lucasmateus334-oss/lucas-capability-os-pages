  .picker-label span{font:600 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.08em;color:#aaa}
  .picker-label strong{font-size:22px;font-weight:500}
  .scenario-tabs{display:grid;grid-template-columns:repeat(3,1fr)}
