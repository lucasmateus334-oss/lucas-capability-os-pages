<section class="impact-demo" id="impact-demo" aria-labelledby="impact-title">
  <header class="impact-head">
    <span>02 / C LAB IN PRACTICE</span>
    <div>
      <p>Interactive walkthrough</p>
      <h2 id="impact-title">Don’t just read it.<br />Try the logic.</h2>
      <p class="intro">Pick a context, then click through four steps. The experience shows how Capability Lab principles can turn fragmented work into something structured, reviewable and easier to trust.</p>
    </div>
  </header>

  <div class="impact-shell" data-impact-demo data-tone="recruiting">
    <div class="scenario-picker">
      <div class="picker-label">
        <span>Choose a context</span>
        <strong>01 / 03</strong>
      </div>
      <div class="scenario-tabs" role="tablist" aria-label="Choose an illustrative scenario">
        <button type="button" role="tab" aria-selected="true" data-scenario="recruiting">
          <span class="tab-index">01</span>
          <span class="tab-copy"><strong>Recruiting</strong><small>Hiring + candidate experience</small></span>
          <span class="tab-arrow">→</span>
        </button>
        <button type="button" role="tab" aria-selected="false" data-scenario="learning">
          <span class="tab-index">02</span>
          <span class="tab-copy"><strong>Learning & Operations</strong><small>Knowledge + continuity</small></span>
          <span class="tab-arrow">→</span>
        </button>
        <button type="button" role="tab" aria-selected="false" data-scenario="community">
          <span class="tab-index">03</span>
          <span class="tab-copy"><strong>Community / Public Value</strong><small>Evidence + accountability</small></span>
          <span class="tab-arrow">→</span>
        </button>
      </div>
    </div>

    <div class="scenario-context" aria-live="polite">
      <div class="context-kicker">
        <span class="scenario-label" data-field="label">Recruiting scenario</span>
        <span>Illustrative case</span>
      </div>
      <h3 data-field="title">A high-volume hiring process is scattered across notes, spreadsheets and individual judgment.</h3>
      <p data-field="summary">The problem is not simply speed. Important criteria, evidence and handoffs can become hard to trace when work is fragmented across people and tools.</p>
      <button type="button" class="start-button" data-action="start">Walk through the 4 steps <span>↓</span></button>
    </div>

    <div class="journey" data-journey>
      <div class="journey-head">
        <div>
          <span>Follow the transformation</span>
          <strong>Step <b data-progress>1</b> of 4</strong>
        </div>
        <div class="progress-track" aria-hidden="true"><span data-progress-bar></span></div>
      </div>

      <ol class="impact-flow" aria-label="Illustrative Capability Lab workflow">
        <li>
          <button type="button" data-step="0" aria-current="step">
            <span class="step-number">01</span>
            <span class="step-state">START HERE</span>
            <strong>Raw work</strong>
            <p data-field="input">Candidate signals, role requirements, interview notes and operational tasks arrive in different formats.</p>
          </button>
        </li>
        <li>
          <button type="button" data-step="1">
            <span class="step-number">02</span>
            <span class="step-state">ORGANIZE</span>
            <strong>Structure</strong>
            <p data-field="structure">AI-assisted workflows help organize inputs into explicit criteria, tasks and evidence references.</p>
          </button>
        </li>
        <li>
          <button type="button" data-step="2">
            <span class="step-number">03</span>
            <span class="step-state">CHECK</span>
            <strong>Human review</strong>
            <p data-field="review">People keep decision authority while checking evidence, exceptions and context before a conclusion is accepted.</p>
          </button>
        </li>
        <li>
          <button type="button" data-step="3">
            <span class="step-number">04</span>
            <span class="step-state">RESULT</span>
            <strong>Verifiable output</strong>
            <p data-field="output">The resulting process is easier to inspect, explain, repeat and improve instead of depending on memory alone.</p>
          </button>
        </li>
      </ol>

      <div class="active-step" aria-live="polite">
        <div class="active-marker"><span data-active-number>01</span></div>
        <div>
          <span class="active-kicker" data-active-kicker>START HERE · RAW WORK</span>
          <p data-active-text>Candidate signals, role requirements, interview notes and operational tasks arrive in different formats.</p>
        </div>
        <button type="button" class="next-step" data-next>Next step →</button>
      </div>
    </div>

    <div class="impact-value" data-result>
      <div class="value-main">
        <span>Potential value</span>
        <p data-field="value">Clearer criteria, more traceable handoffs and a stronger basis for consistent candidate communication and process review.</p>
      </div>
      <div class="value-method">
        <span>What C Lab adds</span>
        <p data-field="capability">A method for separating assumptions from evidence and making the path from input to decision visible.</p>
      </div>
    </div>

    <p class="impact-note">Illustrative model only — not a claim of production deployment, guaranteed outcomes or automated decision-making. This demo runs locally in your browser and does not send or store visitor data.</p>
  </div>
</section>

<script>
  const scenarios = {
    recruiting: {
      label: 'Recruiting scenario',
      title: 'A high-volume hiring process is scattered across notes, spreadsheets and individual judgment.',
      summary: 'The problem is not simply speed. Important criteria, evidence and handoffs can become hard to trace when work is fragmented across people and tools.',
      input: 'Candidate signals, role requirements, interview notes and operational tasks arrive in different formats.',
      structure: 'AI-assisted workflows help organize inputs into explicit criteria, tasks and evidence references.',
      review: 'People keep decision authority while checking evidence, exceptions and context before a conclusion is accepted.',
      output: 'The resulting process is easier to inspect, explain, repeat and improve instead of depending on memory alone.',
      value: 'Clearer criteria, more traceable handoffs and a stronger basis for consistent candidate communication and process review.',
      capability: 'A method for separating assumptions from evidence and making the path from input to decision visible.'
    },
    learning: {
      label: 'Learning & Operations scenario',
      title: 'A team is onboarding people while knowledge lives across documents, messages and a few experienced employees.',
      summary: 'When operating knowledge is fragmented, new people may receive different answers and teams can lose context when responsibilities change.',
      input: 'Guides, policies, task history, stakeholder notes and recurring questions are distributed across multiple sources.',
      structure: 'The workflow maps recurring tasks, source evidence, dependencies and decision points into a shared operating structure.',
      review: 'Subject-matter owners validate what is current, what is uncertain and which exceptions still require human judgment.',
      output: 'Knowledge becomes easier to transfer, update and reproduce without pretending every situation can be fully automated.',
      value: 'Faster orientation, less dependence on individual memory and clearer ownership of operational knowledge.',
      capability: 'A reproducibility layer that connects instructions to sources, review status and the people responsible for validating them.'
    },
    community: {
      label: 'Community / Public Value scenario',
      title: 'A social or community program needs to understand whether its activities are producing evidence of meaningful progress.',
      summary: 'Programs often collect documents, observations and outcomes, but the reasoning connecting those inputs to conclusions can remain opaque or inconsistent.',
      input: 'Program goals, participant feedback, activity records, observations and outcome evidence arrive with different levels of quality.',
      structure: 'The system separates goals, claims, evidence and open questions so each conclusion can be traced back to what supports it.',
      review: 'Humans review sensitive context, challenge weak evidence and decide which conclusions are justified or still uncertain.',
      output: 'The program gains a clearer record of what is known, what is not known and what should be tested or improved next.',
      value: 'Greater transparency, stronger continuity between teams and better visibility into why a program decision was made.',
      capability: 'An evidence-first operating pattern that can make complex evaluation easier to inspect without replacing domain experts or public accountability.'
    }
  };

  const stepMeta = [
    { kicker: 'START HERE · RAW WORK', field: 'input' },
    { kicker: 'ORGANIZE · STRUCTURE', field: 'structure' },
    { kicker: 'CHECK · HUMAN REVIEW', field: 'review' },
    { kicker: 'RESULT · VERIFIABLE OUTPUT', field: 'output' }
  ] as const;

  type ScenarioKey = keyof typeof scenarios;
  type ScenarioField = keyof (typeof scenarios)['recruiting'];

  document.querySelectorAll<HTMLElement>('[data-impact-demo]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-scenario]'));
    const fields = Array.from(root.querySelectorAll<HTMLElement>('[data-field]'));
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-step]'));
    const progress = root.querySelector<HTMLElement>('[data-progress]');
    const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]');
    const activeNumber = root.querySelector<HTMLElement>('[data-active-number]');
    const activeKicker = root.querySelector<HTMLElement>('[data-active-kicker]');
    const activeText = root.querySelector<HTMLElement>('[data-active-text]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const start = root.querySelector<HTMLButtonElement>('[data-action="start"]');
    const journey = root.querySelector<HTMLElement>('[data-journey]');
    const result = root.querySelector<HTMLElement>('[data-result]');
    let currentScenario: ScenarioKey = 'recruiting';
    let currentStep = 0;

    const renderStep = (index: number) => {
      const safeIndex = Math.max(0, Math.min(index, steps.length - 1));
      currentStep = safeIndex;
      const scenario = scenarios[currentScenario];
      const meta = stepMeta[safeIndex];

      steps.forEach((button, buttonIndex) => {
        const active = buttonIndex === safeIndex;
        if (active) button.setAttribute('aria-current', 'step');
        else button.removeAttribute('aria-current');
      });

      if (progress) progress.textContent = String(safeIndex + 1);
      if (progressBar) progressBar.style.width = `${((safeIndex + 1) / steps.length) * 100}%`;
      if (activeNumber) activeNumber.textContent = String(safeIndex + 1).padStart(2, '0');
      if (activeKicker) activeKicker.textContent = meta.kicker;
      if (activeText) activeText.textContent = scenario[meta.field];
      if (next) next.textContent = safeIndex === steps.length - 1 ? 'Restart ↺' : 'Next step →';
      result?.classList.toggle('is-revealed', safeIndex === steps.length - 1);
    };

    const renderScenario = (key: ScenarioKey) => {
      currentScenario = key;
      const scenario = scenarios[key];
      root.dataset.tone = key;

      buttons.forEach((button) => {
        const active = button.dataset.scenario === key;
        button.setAttribute('aria-selected', String(active));
      });

      fields.forEach((field) => {
        const fieldName = field.dataset.field as ScenarioField | undefined;
        if (fieldName) field.textContent = scenario[fieldName];
      });

      renderStep(0);
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.scenario as ScenarioKey | undefined;
        if (key && key in scenarios) renderScenario(key);
      });
    });

    steps.forEach((button) => {
      button.addEventListener('click', () => renderStep(Number(button.dataset.step ?? 0)));
    });

    next?.addEventListener('click', () => renderStep(currentStep === steps.length - 1 ? 0 : currentStep + 1));
    start?.addEventListener('click', () => {
      journey?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      renderStep(0);
    });
  });
</script>

<style>
  .impact-demo{padding:72px 0 94px;border-bottom:1px solid #111}
  .impact-head{display:grid;grid-template-columns:220px 1fr;gap:38px;align-items:start;margin-bottom:42px}
  .impact-head>span{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#6c6c67;letter-spacing:.05em}
  .impact-head p{margin:0 0 12px;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#6f6f69}
  .impact-head h2{max-width:1050px;margin:0;font-size:clamp(48px,7vw,104px);line-height:.88;letter-spacing:-.07em;font-weight:500}
  .impact-head .intro{max-width:760px;margin:24px 0 0;font-size:16px;line-height:1.65;text-transform:none;letter-spacing:0;color:#4f534e}

  .impact-shell{--accent:#176b52;--accent-soft:#dfeee8;--accent-ink:#0c4534;border:1px solid #111;background:#fff;box-shadow:0 18px 60px rgba(17,17,15,.08);transition:background .25s ease}
  .impact-shell[data-tone="learning"]{--accent:#3457d5;--accent-soft:#e2e8ff;--accent-ink:#20398e}
