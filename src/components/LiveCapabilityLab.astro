<section class="live-lab" id="live-experiment" aria-labelledby="live-title">
  <header class="live-head">
    <span>04 / LIVE EXPERIMENT</span>
    <div>
      <p class="eyebrow">Capability Evolution Lab · Experiment 02</p>
      <h2 id="live-title">Give C Lab a problem.<br />Watch the method work.</h2>
      <p class="intro">Write a real problem in plain language. You will see a quick AI answer and a second answer that goes through the C Lab operating loop first.</p>
    </div>
  </header>

  <div class="live-shell" data-live-lab data-endpoint="https://capability-os-home-base-cs16-previe.vercel.app/api/live-experiment">
    <section class="input-stage" aria-label="Live experiment input">
      <div class="input-copy">
        <span class="step-label">YOUR PROBLEM</span>
        <h3>No special prompt needed.</h3>
        <p>Explain the problem like you would explain it to a smart teenager.</p>
      </div>
      <div class="composer">
        <textarea data-problem maxlength="700" rows="5" placeholder="Example: Our small team has 30 days to launch a mentoring program, but information is scattered and nobody agrees on what success means."></textarea>
        <div class="samples" aria-label="Example problems">
          <button type="button" data-sample="We have 300 job applicants, notes are scattered across different places, and our team needs a fair and clear way to decide what to review first.">Hiring</button>
          <button type="button" data-sample="A new team is starting next month, but important knowledge lives in old documents and in the heads of a few experienced people.">Team onboarding</button>
          <button type="button" data-sample="A community project has many activities, but we do not have a clear way to show what is working, what is uncertain, and what should change next.">Community project</button>
        </div>
        <div class="run-row">
          <button type="button" class="run-button" data-run>Run live experiment →</button>
          <small>20–700 characters · no account · no storage</small>
        </div>
        <p class="input-error" data-input-error hidden></p>
      </div>
    </section>

    <section class="working-stage" data-working hidden aria-live="polite">
      <div class="working-head">
        <div>
          <span class="step-label">SAME PROBLEM · TWO METHODS</span>
          <h3>Watch the work, not private reasoning.</h3>
        </div>
        <div class="live-status"><span class="pulse"></span><b data-live-status>Running</b></div>
      </div>

      <div class="lanes">
        <article class="lane quick-lane">
          <div class="lane-title">
            <span>A</span>
            <div><b>Quick AI</b><small>one pass</small></div>
          </div>
          <ol class="mini-flow">
            <li data-quick-step="0"><i></i><span>Read the problem</span></li>
            <li data-quick-step="1"><i></i><span>Write an answer</span></li>
          </ol>
          <p class="lane-note">Fast and useful, but most checks stay implicit.</p>
        </article>

        <article class="lane clab-lane">
          <div class="lane-title">
            <span>B</span>
            <div><b>AI + C Lab</b><small>operating loop</small></div>
          </div>
          <ol class="clab-flow">
            <li data-clab-step="0"><i></i><div><b>1. Understand the goal</b><span>What are we actually trying to solve?</span><p data-trace="goal"></p></div></li>
            <li data-clab-step="1"><i></i><div><b>2. Separate facts from guesses</b><span>What do we know, assume or still need?</span><p data-trace="known"></p></div></li>
            <li data-clab-step="2"><i></i><div><b>3. Build checkable pieces</b><span>Turn the problem into steps we can inspect.</span><p data-trace="plan"></p></div></li>
            <li data-clab-step="3"><i></i><div><b>4. Challenge the draft</b><span>Look for weak points before accepting it.</span><p data-trace="critique"></p></div></li>
            <li data-clab-step="4"><i></i><div><b>5. Add human review</b><span>Mark where a person should check context.</span><p data-trace="review"></p></div></li>
            <li data-clab-step="5"><i></i><div><b>6. Build the final answer</b><span>Answer with uncertainty and checkpoints visible.</span></div></li>
          </ol>
        </article>
      </div>
    </section>

    <section class="results-stage" data-results hidden>
      <header class="results-head">
        <span class="step-label">RESULT</span>
        <h3>Same problem. Different operating method.</h3>
      </header>

      <div class="answers">
        <article>
          <div class="answer-head"><span>A</span><b>Quick AI</b></div>
          <p data-baseline></p>
        </article>
        <article class="clab-answer">
          <div class="answer-head"><span>B</span><b>AI + C Lab</b></div>
          <p data-clab-answer></p>
        </article>
      </div>

      <div class="comparison">
        <div class="comparison-title">
          <span class="step-label">MODEL-ASSISTED CHECK</span>
          <h4>What changed?</h4>
          <p>The evaluator sees only the two final answers. It does not automatically favor C Lab.</p>
        </div>
        <div class="score-grid" data-score-grid></div>
      </div>

      <p class="result-note" data-disclosure>Visible progress shows short work-state summaries, not hidden chain-of-thought. Scores are an illustrative model-assisted comparison, not scientific validation.</p>
      <button type="button" class="again" data-run-again>Try another problem ↺</button>
    </section>

    <section class="live-error" data-live-error hidden>
      <span>LIVE ENGINE</span>
      <h3>The live model is not connected yet.</h3>
      <p>The interface and secure backend contract are ready. Experiment 01 above remains fully usable while the server-side Gemini connection is activated.</p>
    </section>

    <p class="privacy-note">Designed for general planning and learning experiments. Do not paste confidential, medical, legal or other sensitive personal information. The public interface does not intentionally store your problem.</p>
  </div>
</section>

<script>
  type ScoreItem = { baseline: number; clab: number; why: string };
  type LivePayload = {
    baseline: string;
    clab: string;
    trace: Record<string, string>;
    evaluation: Record<string, ScoreItem>;
    disclosure?: string;
  };

  document.querySelectorAll<HTMLElement>('[data-live-lab]').forEach((root) => {
    const endpoint = root.dataset.endpoint || '';
    const problem = root.querySelector<HTMLTextAreaElement>('[data-problem]');
    const run = root.querySelector<HTMLButtonElement>('[data-run]');
    const working = root.querySelector<HTMLElement>('[data-working]');
    const results = root.querySelector<HTMLElement>('[data-results]');
    const liveError = root.querySelector<HTMLElement>('[data-live-error]');
    const inputError = root.querySelector<HTMLElement>('[data-input-error]');
    const status = root.querySelector<HTMLElement>('[data-live-status]');
    const baseline = root.querySelector<HTMLElement>('[data-baseline]');
    const clabAnswer = root.querySelector<HTMLElement>('[data-clab-answer]');
    const scoreGrid = root.querySelector<HTMLElement>('[data-score-grid]');
    const disclosure = root.querySelector<HTMLElement>('[data-disclosure]');
    const quickSteps = Array.from(root.querySelectorAll<HTMLElement>('[data-quick-step]'));
    const clabSteps = Array.from(root.querySelectorAll<HTMLElement>('[data-clab-step]'));
    const traceNodes = Array.from(root.querySelectorAll<HTMLElement>('[data-trace]'));

    const setActiveStep = (index: number) => {
      clabSteps.forEach((step, current) => {
        step.classList.toggle('is-active', current === index);
        step.classList.toggle('is-done', current < index);
      });
    };

    const reset = () => {
      results?.setAttribute('hidden', '');
      liveError?.setAttribute('hidden', '');
      working?.setAttribute('hidden', '');
      if (inputError) inputError.hidden = true;
      quickSteps.forEach((step) => step.classList.remove('is-active', 'is-done'));
      clabSteps.forEach((step) => step.classList.remove('is-active', 'is-done'));
      traceNodes.forEach((node) => { node.textContent = ''; });
    };

    root.querySelectorAll<HTMLButtonElement>('[data-sample]').forEach((button) => {
      button.addEventListener('click', () => {
        if (problem) problem.value = button.dataset.sample || '';
        problem?.focus();
      });
    });

    const renderScores = (evaluation: Record<string, ScoreItem>) => {
      if (!scoreGrid) return;
      const labels: Record<string, string> = {
        clarity: 'Clarity',
        traceability: 'Traceability',
        uncertainty: 'Handles uncertainty',
        reviewability: 'Easy to review'
      };
      scoreGrid.innerHTML = '';
      Object.entries(labels).forEach(([key, label]) => {
        const item = evaluation[key];
        if (!item) return;
        const row = document.createElement('article');
        row.className = 'score-row';
        row.innerHTML = `<div class="score-label"><b>${label}</b><small>${item.why || ''}</small></div><div class="score-bars"><div><span>Quick AI</span><i><em style="width:${Math.max(0, Math.min(100, item.baseline * 25))}%"></em></i><b>${item.baseline}/4</b></div><div class="clab-score"><span>C Lab</span><i><em style="width:${Math.max(0, Math.min(100, item.clab * 25))}%"></em></i><b>${item.clab}/4</b></div></div>`;
        scoreGrid.appendChild(row);
      });
    };

    const execute = async () => {
      const value = problem?.value.trim() || '';
      reset();
      if (value.length < 20 || value.length > 700) {
        if (inputError) {
          inputError.textContent = 'Write at least 20 characters and keep it under 700.';
          inputError.hidden = false;
        }
        return;
      }

      if (working) working.hidden = false;
      working?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      run?.setAttribute('disabled', '');
      if (status) status.textContent = 'Reading the problem';
      quickSteps[0]?.classList.add('is-active');
      setActiveStep(0);

      const labels = ['Understanding the goal', 'Separating facts from guesses', 'Building checkable pieces', 'Challenging the draft', 'Adding human review', 'Building the final answer'];
      let visualStep = 0;
      const timer = window.setInterval(() => {
        quickSteps[0]?.classList.add('is-done');
        quickSteps[1]?.classList.add('is-active');
        visualStep = Math.min(visualStep + 1, clabSteps.length - 1);
        setActiveStep(visualStep);
        if (status) status.textContent = labels[visualStep] || 'Working';
      }, 950);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          cache: 'no-store',
          credentials: 'omit',
          headers: {
            'Content-Type': 'application/json',
            'X-C-Lab-Client': 'public-live-v2'
          },
          body: JSON.stringify({ problem: value })
        });

        if (!response.ok) throw new Error(String(response.status));
        const payload = await response.json() as LivePayload;
        window.clearInterval(timer);
        quickSteps.forEach((step) => step.classList.add('is-done'));
        clabSteps.forEach((step) => step.classList.add('is-done'));
        if (status) status.textContent = 'Complete';

        traceNodes.forEach((node) => {
          const key = node.dataset.trace || '';
          node.textContent = payload.trace?.[key] || '';
        });
        if (baseline) baseline.textContent = payload.baseline || '';
        if (clabAnswer) clabAnswer.textContent = payload.clab || '';
        renderScores(payload.evaluation || {});
        if (disclosure && payload.disclosure) disclosure.textContent = payload.disclosure;
        if (results) results.hidden = false;
        results?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch {
        window.clearInterval(timer);
        if (working) working.hidden = true;
        if (liveError) liveError.hidden = false;
        liveError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } finally {
        run?.removeAttribute('disabled');
      }
    };

    run?.addEventListener('click', execute);
    root.querySelector<HTMLButtonElement>('[data-run-again]')?.addEventListener('click', () => {
      reset();
      problem?.focus();
      problem?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>

