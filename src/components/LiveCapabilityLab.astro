  .working-stage{padding:38px;background:#10110f;color:#f4f4ef}.working-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:28px}.working-head h3{margin:10px 0 0;font-size:30px}.working-stage .step-label{color:#999b93}.live-status{display:flex;align-items:center;gap:9px;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.pulse{width:9px;height:9px;border-radius:50%;background:#68d391;box-shadow:0 0 0 0 rgba(104,211,145,.45);animation:livePulse 1.5s infinite}@keyframes livePulse{70%{box-shadow:0 0 0 10px rgba(104,211,145,0)}100%{box-shadow:0 0 0 0 rgba(104,211,145,0)}}
  .lanes{display:grid;grid-template-columns:.62fr 1.38fr;gap:1px;background:#343530;border:1px solid #343530}.lane{background:#171815;padding:26px}.lane-title{display:flex;gap:14px;align-items:center}.lane-title>span,.answer-head span{display:grid;place-items:center;width:34px;height:34px;border:1px solid #777;font:700 11px ui-monospace,SFMono-Regular,Menlo,monospace}.lane-title div{display:grid}.lane-title b{font-size:18px}.lane-title small{margin-top:3px;color:#95978f;font:500 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase}.mini-flow,.clab-flow{list-style:none;margin:34px 0 0;padding:0}.mini-flow li,.clab-flow li{position:relative;display:flex;gap:14px;padding:0 0 28px;color:#777a72}.mini-flow li:last-child,.clab-flow li:last-child{padding-bottom:0}.mini-flow li i,.clab-flow li i{flex:0 0 13px;width:13px;height:13px;margin-top:2px;border:1px solid #666;border-radius:50%;background:#171815;transition:.25s ease}.mini-flow li:not(:last-child)::after,.clab-flow li:not(:last-child)::after{content:"";position:absolute;left:6px;top:18px;bottom:6px;width:1px;background:#494a45}.mini-flow li.is-active,.clab-flow li.is-active{color:#fff}.mini-flow li.is-active i,.clab-flow li.is-active i{background:#f1bf56;border-color:#f1bf56;box-shadow:0 0 0 4px rgba(241,191,86,.12)}.mini-flow li.is-done,.clab-flow li.is-done{color:#d8dad2}.mini-flow li.is-done i,.clab-flow li.is-done i{background:#63b987;border-color:#63b987}.clab-flow li div{display:grid;gap:5px}.clab-flow li b{font-size:14px}.clab-flow li span,.mini-flow span{font-size:12px;line-height:1.45}.clab-flow li p{display:none;margin:5px 0 0;padding:10px 12px;border-left:2px solid #63b987;background:#20221e;color:#c9cbc3;font-size:11px;line-height:1.5}.clab-flow li.is-done p:not(:empty){display:block}.lane-note{margin:38px 0 0;color:#8d8f87;font-size:11px;line-height:1.5}
  .results-stage{padding:38px;border-top:1px solid #111}.results-head h3{margin:12px 0 30px;font-size:clamp(34px,5vw,68px);line-height:.95;letter-spacing:-.055em;font-weight:500}.answers{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#bbbcb5;border:1px solid #bbbcb5}.answers article{min-height:320px;padding:28px;background:#fff}.answers .clab-answer{background:#e6eee8}.answer-head{display:flex;gap:12px;align-items:center}.answer-head b{font-size:16px}.answers article>p{white-space:pre-wrap;margin:44px 0 0;font-size:14px;line-height:1.7;color:#3e413d}.comparison{display:grid;grid-template-columns:.65fr 1.35fr;gap:50px;margin-top:48px;padding-top:38px;border-top:1px solid #bbbcb5}.comparison-title h4{margin:12px 0;font-size:34px;letter-spacing:-.04em}.comparison-title p{max-width:360px;margin:0;color:#666862;font-size:12px;line-height:1.55}.score-grid{border-top:1px solid #aaa}.score-row{display:grid;grid-template-columns:.45fr 1.55fr;gap:28px;padding:18px 0;border-bottom:1px solid #ccc}.score-label{display:grid;align-content:start;gap:6px}.score-label b{font-size:13px}.score-label small{font-size:10px;line-height:1.4;color:#777970}.score-bars{display:grid;gap:10px}.score-bars>div{display:grid;grid-template-columns:72px 1fr 42px;gap:10px;align-items:center}.score-bars span{font-size:10px}.score-bars i{height:8px;background:#deded8;overflow:hidden}.score-bars em{display:block;height:100%;background:#666}.score-bars .clab-score em{background:#1f7657}.score-bars b{text-align:right;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace}.result-note,.privacy-note{margin:28px 0 0;font:500 9px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;color:#74766f}.again{margin-top:18px}.live-error{padding:38px;background:#fff4dd;border-top:1px solid #d8b96e}.live-error span{font:700 9px ui-monospace,SFMono-Regular,Menlo,monospace}.live-error h3{margin:10px 0;font-size:28px}.live-error p{max-width:760px;margin:0;font-size:13px;line-height:1.6}.privacy-note{margin:0;padding:17px 38px;border-top:1px solid #d0d0c8;background:#f0efe9}
