---
import telemetry from '../data/telemetry_source.json';

type Maturity = 'materialized_evidence_backed_eval_required' | 'scaffold_unverified';

type Engine = {
  id: string;
  name: string;
  maturity: Maturity;
  public_ref: string;
};

const engines = telemetry.engines as Engine[];

const labelFor = (maturity: Maturity): string =>
  maturity === 'materialized_evidence_backed_eval_required'
    ? 'Materialized · eval required'
    : 'Scaffold · unverified';

const shortStateFor = (maturity: Maturity): string =>
  maturity === 'materialized_evidence_backed_eval_required' ? 'materialized' : 'scaffold';
---

<section class="registry" aria-labelledby="capability-registry-title" data-capability-registry>
  <div class="registry-head">
    <div>
      <h2 id="capability-registry-title">Capability registry</h2>
      <p>Telemetry-backed public status. Internal contracts, receipts and credentials remain private.</p>
    </div>
    <div class="registry-meta" aria-label="Registry summary">
      <span><b>{telemetry.summary.engine_count}</b> indexed</span>
      <span><b>{telemetry.summary.materialized_candidate_count}</b> materialized</span>
      <span><b>{telemetry.summary.scaffold_unverified_count}</b> scaffold</span>
    </div>
  </div>

  <div class="registry-controls" aria-label="Capability registry controls">
    <label class="search-wrap">
      <span class="sr-only">Search capabilities</span>
      <input type="search" placeholder="Search capability…" autocomplete="off" data-registry-search />
    </label>
    <div class="filters" role="group" aria-label="Filter by status">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="materialized" aria-pressed="false">Materialized</button>
      <button type="button" data-filter="scaffold" aria-pressed="false">Scaffold</button>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col"><button type="button" data-sort="name">Capability <span aria-hidden="true">↕</span></button></th>
          <th scope="col"><button type="button" data-sort="status">Status <span aria-hidden="true">↕</span></button></th>
          <th scope="col"><button type="button" data-sort="ref">Public ref <span aria-hidden="true">↕</span></button></th>
        </tr>
      </thead>
      <tbody data-registry-body>
        {engines.map((engine) => {
          const status = shortStateFor(engine.maturity);
          return (
            <tr
              data-registry-row
              data-status={status}
              data-name={engine.name.toLowerCase()}
              data-ref={engine.public_ref.toLowerCase()}
              data-search={`${engine.name} ${engine.public_ref} ${labelFor(engine.maturity)}`.toLowerCase()}
            >
              <td>
                <div class="capability-name">
                  <span class:list={['status-dot', status === 'materialized' && 'is-materialized']} aria-hidden="true"></span>
                  <span>
                    <strong>{engine.name}</strong>
                    <code>{engine.id}</code>
                  </span>
                </div>
              </td>
              <td><span class:list={['state-pill', status === 'materialized' && 'is-materialized']}>{labelFor(engine.maturity)}</span></td>
              <td><code>{engine.public_ref}</code></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="registry-foot">
    <span data-result-count>{engines.length} capabilities</span>
    <span>Telemetry Mode: Fallback</span>
  </div>
</section>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-capability-registry]');

  for (const root of roots) {
    const input = root.querySelector<HTMLInputElement>('[data-registry-search]');
    const body = root.querySelector<HTMLTableSectionElement>('[data-registry-body]');
    const count = root.querySelector<HTMLElement>('[data-result-count]');
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const sortButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sort]'));

    if (!input || !body || !count) continue;

    let activeFilter = 'all';
    let sortKey = 'name';
    let sortDirection: 'asc' | 'desc' = 'asc';

    const rows = (): HTMLTableRowElement[] => Array.from(body.querySelectorAll<HTMLTableRowElement>('[data-registry-row]'));

    const apply = (): void => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      for (const row of rows()) {
        const status = row.dataset.status ?? '';
        const haystack = row.dataset.search ?? '';
        const matchesFilter = activeFilter === 'all' || status === activeFilter;
        const matchesQuery = query === '' || haystack.includes(query);
        const show = matchesFilter && matchesQuery;
        row.hidden = !show;
        if (show) visible += 1;
      }

      count.textContent = `${visible} ${visible === 1 ? 'capability' : 'capabilities'}`;
    };

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.filter ?? 'all';
        for (const candidate of filterButtons) {
          candidate.setAttribute('aria-pressed', String(candidate === button));
        }
        apply();
      });
    }

    input.addEventListener('input', apply);

    for (const button of sortButtons) {
      button.addEventListener('click', () => {
        const nextKey = button.dataset.sort ?? 'name';
        if (sortKey === nextKey) {
          sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
          sortKey = nextKey;
          sortDirection = 'asc';
        }

        const keyFor = (row: HTMLTableRowElement): string => {
          if (sortKey === 'status') return row.dataset.status ?? '';
          if (sortKey === 'ref') return row.dataset.ref ?? '';
          return row.dataset.name ?? '';
        };

        const sorted = rows().sort((a, b) => {
          const result = keyFor(a).localeCompare(keyFor(b));
          return sortDirection === 'asc' ? result : -result;
        });

        for (const row of sorted) body.appendChild(row);
      });
    }
  }
</script>

<style>
  .registry{border:1px solid #d5cec2;border-radius:16px;background:rgba(255,255,255,.32);overflow:hidden}
  .registry-head{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding:22px 22px 18px;border-bottom:1px solid #d9d2c6}
  .registry-head h2{margin:0;font:500 26px Georgia,serif;letter-spacing:-.02em}
  .registry-head p{margin:5px 0 0;font-size:12px;color:#626760;line-height:1.6}
  .registry-meta{display:flex;gap:16px;flex-wrap:wrap;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#6c716a;text-transform:uppercase;letter-spacing:.06em}
  .registry-meta b{color:#111713}
  .registry-controls{display:flex;justify-content:space-between;gap:16px;padding:14px 22px;border-bottom:1px solid #ddd6ca;background:rgba(255,255,255,.18)}
  .search-wrap{min-width:min(320px,100%)}
  input{width:100%;height:38px;border:1px solid #c9c2b6;border-radius:8px;background:#f8f6f1;color:#111713;padding:0 12px;font:500 12px Inter,ui-sans-serif,system-ui,sans-serif;outline:none}
  input:focus{border-color:#197a57;box-shadow:0 0 0 3px rgba(25,122,87,.12)}
  .filters{display:flex;gap:6px;flex-wrap:wrap}
  .filters button{height:38px;padding:0 12px;border:1px solid #c9c2b6;border-radius:8px;background:transparent;color:#303630;font:700 10px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.05em;cursor:pointer}
  .filters button[aria-pressed="true"]{background:#111713;color:#fff;border-color:#111713}
  .table-wrap{overflow-x:auto}
  table{width:100%;border-collapse:collapse;min-width:680px}
  th,td{padding:13px 22px;text-align:left;border-bottom:1px solid #e0d9cd;vertical-align:middle}
  th{background:rgba(241,237,229,.72);font:700 9px ui-monospace,SFMono-Regular,Menlo,monospace;text-transform:uppercase;letter-spacing:.09em;color:#6b7069}
  th button{border:0;background:transparent;padding:0;color:inherit;font:inherit;text-transform:inherit;letter-spacing:inherit;cursor:pointer}
  tbody tr:last-child td{border-bottom:0}
  tbody tr:hover{background:rgba(255,255,255,.34)}
  .capability-name{display:flex;align-items:center;gap:12px}
  .capability-name strong{display:block;font-size:12px;color:#171c18}
  code{font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#737871}
  .status-dot{width:8px;height:8px;border-radius:50%;background:#9ea39d;box-shadow:0 0 0 4px #e9e3d8;flex:none}
  .status-dot.is-materialized{background:#197a57}
  .state-pill{display:inline-flex;align-items:center;min-height:26px;padding:0 9px;border:1px solid #c7c1b6;border-radius:999px;font:700 9px ui-monospace,SFMono-Regular,Menlo,monospace;color:#656a64;text-transform:uppercase;letter-spacing:.04em;white-space:nowrap}
  .state-pill.is-materialized{border-color:#9fcab9;color:#116947;background:#edf7f2}
  .registry-foot{display:flex;justify-content:space-between;gap:16px;padding:12px 22px;border-top:1px solid #ddd6ca;font:600 10px ui-monospace,SFMono-Regular,Menlo,monospace;color:#70756e;text-transform:uppercase;letter-spacing:.05em}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  [hidden]{display:none!important}
  @media(max-width:720px){.registry-head,.registry-controls,.registry-foot{align-items:stretch;flex-direction:column}.registry-meta{gap:10px}.search-wrap{min-width:0}}
</style>
